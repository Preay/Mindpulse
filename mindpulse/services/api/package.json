{
  "name": "@mindpulse/api",
  "version": "1.0.0",
  "description": "MindPulse API Service - Node.js + Fastify",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate": "node dist/scripts/migrate.js"
  },
  "dependencies": {
    "fastify": "^4.25.2",
    "@fastify/cors": "^8.5.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.0.1",
    "pg": "^8.11.3",
    "mongodb": "^6.3.0",
    "redis": "^4.6.12",
    "bull": "^4.12.3",
    "jsonwebtoken": "^9.1.2",
    "bcryptjs": "^2.4.3",
    "axios": "^1.6.4",
    "dotenv": "^16.3.1",
    "zod": "^3.22.4",
    "@aws-sdk/client-s3": "^3.450.0",
    "crypto-js": "^4.2.0",
    "@mindpulse/shared-types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.10.6",
    "tsx": "^4.7.0",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=18.0.0"
